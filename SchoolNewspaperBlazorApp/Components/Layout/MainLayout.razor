@inherits LayoutComponentBase

<input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Menu" />

<header class="site-header">
    <label for="menu-toggle" class="menu-button">
        <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
            <path d="M3 7h24M3 15h24M3 23h24" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
        </svg>
        <span class="visually-hidden">Otwórz menu</span>
    </label>

    <a class="site-title" href="/">Elitarne Technikum Informatyczne im. Tadeusza Kościuszki</a>

    <a class="site-logo" href="/">
        <img src="img/logo-eti.png" alt="Logo szkoły" />
    </a>
</header>

<label for="menu-toggle" class="drawer-backdrop" aria-hidden="true"></label>

<aside class="drawer" aria-label="Menu główne">
    <div class="drawer-head">
        <span class="drawer-brand">Gazetka szkolna</span>
        <label for="menu-toggle" class="drawer-close">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <path d="M4 4l14 14M18 4L4 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
            </svg>
            <span class="visually-hidden">Zamknij menu</span>
        </label>
    </div>

    <form class="drawer-search" role="search">
        <input class="form-control"
               type="search"
               placeholder="Szukaj..."
               aria-label="Szukaj" />
        <button class="btn btn-primary" type="submit">Szukaj</button>
    </form>

    <nav class="drawer-nav">
        <NavLink href="" Match="NavLinkMatch.All">Strona główna</NavLink>
        <NavLink href="aktualnosci">Aktualności</NavLink>
        <NavLink href="wydarzenia">Wydarzenia</NavLink>

        <div class="drawer-divider"></div>

        <NavLink href="login">Panel logowania</NavLink>
        <NavLink href="adminPanel">Admin Panel</NavLink>
    </nav>
</aside>

<main class="site-main">
    @Body
</main>
