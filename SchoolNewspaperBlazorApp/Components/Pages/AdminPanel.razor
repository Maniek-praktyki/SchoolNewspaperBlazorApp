@page "/adminPanel"
@rendermode InteractiveServer
@inject IArticleService articleService
@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service

<PageTitle>Panel administratora</PageTitle>

<h1 class="admin-heading">Panel administratora</h1>

<div class="admin-toolbar">
    @if (view == 0)
    {
        <button class="btn btn-primary" @onclick="LoadArticleAsync">Panel artykułów</button>
        <button class="btn btn-primary" @onclick=" () => SetView(2)">Dodaj artykuł</button>
        <button class="btn btn-primary" @onclick=" () => SetView(3)">+ Dodaj użytkownika</button>
    }
    else
    {
        <button class="btn btn-ghost" @onclick=" () => SetView(0)">Wróć</button>
    }
</div>

<div class="main-block">
    @if (view == 1)
    {
        <div class="article-panel">
            <ArticleCard Articles="articleList" permissions="true" />
        </div>
    }
    else if (view == 2)
    {
        <ArticleForm />
    }
    else if (view == 3)
    {
        <AddUserForm />
    }
</div>


@code {
    public int view = 0;
    public List<Article> articleList = new List<Article>();
   
    public void SetView(int view)
    {
        this.view = view;
    }
    public async Task LoadArticleAsync()
    {
        articleList = await articleService.GetAllArticlesAsync();
        SetView(1);
    }
}
