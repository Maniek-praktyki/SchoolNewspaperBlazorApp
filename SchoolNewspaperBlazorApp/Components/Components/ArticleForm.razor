@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IArticleService articleService
@inject IFileService fileService

<div class="add-article-form panel">
    <h2 class="add-article-title">Dodaj artykuł</h2>

    @if(previewImage != null)
    {
        <div class="preview-image">
            <img src="@previewImage" alt="Podgląd zdjęcia" />
        </div>
    }

    <div class="field">
        <label for="photo">Zdjęcie</label>
        <InputFile id="photo" class="form-control" OnChange="ChoosePhoto" accept="image/*" />
    </div>

    <form @onsubmit="AddArticle" @onsubmit:preventDefault>
        <div class="field">
            <label for="title">Tytuł</label>
            <input id="title" @bind="Title" class="form-control" />
        </div>
        <div class="field">
            <label for="text">Treść</label>
            <textarea id="text" @bind="Text" class="form-control" rows="8"></textarea>
        </div>
        <div class="field">
            <label for="author">Autor</label>
            <input id="author" @bind="Author" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Dodaj</button>
    </form>
</div>

@code {

    public string Title { get; set; } = "";
    public string Text { get; set; } = "";
    public string Author { get; set; } = "";
    private string? previewImage;
    IBrowserFile file;
    private async Task ChoosePhoto(InputFileChangeEventArgs e)
    {
        file = e.File;
        previewImage = await fileService.GetPreviewAsync(file);    

    }

    private async Task AddArticle()
    {
        int id = 0;
        if (file != null)
        {
             id = await fileService.UploadImage(file);
        }
        await articleService.AddArticleAsync(Title, Text, Author, id);
        
    }
}
